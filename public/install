#!/bin/sh
set -eu

BASE_URL="https://fleet.cenvero.org"
CHANNEL="${FLEET_CHANNEL:-stable}"
OS="$(uname -s 2>/dev/null || echo unknown)"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "missing dependency: $1" >&2; exit 1; }
}

fail() { echo "$1" >&2; exit 1; }

forbidden_ip() {
  ip="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$ip" in ::|::1|fc*|fd*|fe8*|fe9*|fea*|feb*|ff*) return 0 ;; ::ffff:*) ip="${ip##*:}" ;; *:*) return 1 ;; esac
  awk -v ip="$ip" 'BEGIN { n=split(ip,a,"."); if(n!=4) exit 0; for(i=1;i<=4;i++) if(a[i]!~/^[0-9]+$/||a[i]>255) exit 0; if(a[1]==0||a[1]==10||a[1]==127||a[1]>=224||(a[1]==100&&a[2]>=64&&a[2]<=127)||(a[1]==100&&a[2]==100&&a[3]==100&&a[4]==200)||(a[1]==169&&a[2]==254)||(a[1]==172&&a[2]>=16&&a[2]<=31)||(a[1]==192&&a[2]==168)||(a[1]==198&&(a[2]==18||a[2]==19))) exit 0; exit 1 }'
}

resolve_public_host() {
  host_name="$1"
  if command -v getent >/dev/null 2>&1; then addresses="$(getent ahosts "$host_name" 2>/dev/null|awk '{print $1}'|sort -u)"
  elif command -v dscacheutil >/dev/null 2>&1; then addresses="$(dscacheutil -q host -a name "$host_name" 2>/dev/null|awk '/ip_address:/{print $2}'|sort -u)"
  elif command -v dig >/dev/null 2>&1; then addresses="$( { dig +short A "$host_name"; dig +short AAAA "$host_name"; } 2>/dev/null|sort -u)"
  elif command -v host >/dev/null 2>&1; then addresses="$(host "$host_name" 2>/dev/null|awk '/has (IPv6 )?address/{print $NF}'|sort -u)"
  else fail "no DNS resolver tool available for secure installer download"; fi
  [ -n "$addresses" ] || fail "installer host did not resolve: $host_name"
  chosen=""
  for address in $addresses; do forbidden_ip "$address" && fail "installer host resolved to forbidden address: $address"; [ -n "$chosen" ] || chosen="$address"; done
  printf '%s\n' "$chosen"
}

download_site_file() {
  path="$1"; output="$2"; current="${BASE_URL}/${path}"; hop=0
  headers="${output}.headers"; part="${output}.part"
  while :; do
    case "$current" in https://fleet.cenvero.org/*) ;; *) rm -f "$headers" "$part"; fail "refusing installer redirect to unapproved URL: $current" ;; esac
    ip="$(resolve_public_host fleet.cenvero.org)" || fail "installer host address validation failed"
    case "$ip" in *:*) resolve="fleet.cenvero.org:443:[$ip]" ;; *) resolve="fleet.cenvero.org:443:$ip" ;; esac
    status="$(curl -sS --noproxy '*' --proto '=https' --max-redirs 0 --resolve "$resolve" -D "$headers" -o "$part" -w '%{http_code}' "$current")" || fail "failed to download $current"
    case "$status" in
      200) mv "$part" "$output"; rm -f "$headers"; return ;;
      301|302|303|307|308)
        [ "$hop" -lt 2 ] || fail "too many installer redirects"
        location="$(awk 'tolower(substr($0,1,9))=="location:"{sub(/^[^:]*:[[:space:]]*/,"");sub(/\r$/,"");v=$0} END{print v}' "$headers")"
        case "$location" in https://*) current="$location" ;; /*) current="https://fleet.cenvero.org$location" ;; *) fail "refusing ambiguous installer redirect" ;; esac
        hop=$((hop+1)); rm -f "$part" ;;
      *) fail "unexpected installer HTTP status: $status" ;;
    esac
  done
}

run_unix_installer() {
  need curl
  tmp="$(mktemp "${TMPDIR:-/tmp}/fleet-install.XXXXXX.sh")"
  trap 'rm -f "$tmp"' EXIT INT TERM HUP
  download_site_file install.sh "$tmp"
  FLEET_CHANNEL="$CHANNEL" sh "$tmp"
}

run_windows_installer() {
  need curl
  tmp="$(mktemp "${TMPDIR:-/tmp}/fleet-install.XXXXXX.ps1")"
  trap 'rm -f "$tmp"' EXIT INT TERM HUP
  download_site_file install.ps1 "$tmp"

  if command -v pwsh >/dev/null 2>&1; then FLEET_CHANNEL="$CHANNEL" pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$tmp"
  elif command -v powershell.exe >/dev/null 2>&1; then FLEET_CHANNEL="$CHANNEL" powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$tmp"
  elif command -v powershell >/dev/null 2>&1; then FLEET_CHANNEL="$CHANNEL" powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$tmp"
  else echo "missing dependency: PowerShell (pwsh, powershell.exe, or powershell)" >&2; exit 1
  fi
}

case "$OS" in
  Linux|Darwin|FreeBSD|OpenBSD|NetBSD) run_unix_installer ;;
  MINGW*|MSYS*|CYGWIN*) run_windows_installer ;;
  *) echo "unsupported operating system: $OS" >&2; exit 1 ;;
esac
